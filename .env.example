PORT=3000
DB_PATH=./data/stack5.db
NODE_ENV=production
# Used for links in verification / password reset emails
PUBLIC_BASE_URL=https://your-domain.example
# Number of reverse proxies in front of the app (nginx = 1). Set 0 if exposed directly.
TRUST_PROXY=1
# How often queued teams are matched automatically (0 = off)
MATCHMAKING_INTERVAL_SECONDS=30
# Time limits: idle OPEN team disbanded, queue timeout, match accept window
TEAM_OPEN_HOURS=6
QUEUE_HOURS=2
MATCH_ACCEPT_MINUTES=5
TIMERS_INTERVAL_SECONDS=30
# Who may play (set STACK5_ELIGIBILITY=off only for local development)
STACK5_ELIGIBILITY=on
ELIGIBILITY_MIN_STEAM_DAYS=730
ELIGIBILITY_MIN_CS2_HOURS=500
# Email verification (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STACK5 <no-reply@your-domain.example>
# Where Contact-page messages are sent (default contact@stack5cs.com)
CONTACT_EMAIL=contact@stack5cs.com
# Trust score data sources (all free). Steam: steamcommunity.com/dev/apikey
STEAM_API_KEY=
# "Sign in through Steam" is the only way to sign in. For local testing without real Steam, run
# node scripts/fake-steam.js and set STEAM_OPENID_ENDPOINT=http://localhost:3999/openid/login (never in production)
# STEAM_OPENID_ENDPOINT=
# FACEIT: developers.faceit.com (server-side key) — optional
FACEIT_API_KEY=
# Leetify: leetify.com/app/developer — optional, raises rate limits for the live stats panel
LEETIFY_API_KEY=
CSST_BASE_URL=https://csst.at
CSST_ENABLED=false
